                  },
                  {
                    "text": "Felkrash",
                    "steps": [
                      {
                        "player": "Can you tell me where I could find Felkrash?"
                      },
                      {
                        "npc": "Her nibs? She'll be in the rat pits at Port Sarim. Good luck getting in there, though."
                      }
                    ]
                  }
                ]
              }
