    "standard-dialogue-after-completing-ratcatchers": [
      {
        "type": "choice",
        "options": [
          {
            "text": "Can you tell me where I would find ....",
            "steps": [
              {
                "type": "choice",
                "options": [
                  {
                    "text": "Grimesquit and Phingspet",
                    "steps": [
                      {
                        "player": "Can you tell me where I could find Phingspet and Grimesquit?"
                      },
                      {
                        "npc": "The sisters Grime? You'll find them down in the sewers here in Varrock."
                      }
                    ]
                  },
                  {
                    "text": "Jimmy Dazzler",
                    "steps": [
                      {
                        "player": "Can you tell me where I could find Jimmy Dazzler?"
                      },
                      {
                        "npc": "Pah! There's nothing else he can teach you, I'll tell you that."
                      },
                      {
                        "player": "But where would I find him?"
                      },
                      {
                        "npc": "Probably cosying up to the nobles over in Ardougne."
                      },
                      {
                        "player": "What's your problem with Jimmy, anyway?"
                      },
                      {
                        "npc": "He reckons he's too good for the likes of us."
                      },
                      {
                        "player": "Are you sure? He spoke very highly of you."
                      },
                      {
                        "npc": "I'll believe it when I see it."
                      },
                      {
                        "npc": "Anyway. The Flying Horse, Ardougne. You'll find him there."
                      }
                    ]
                  },
                  {
                    "text": "Smokin' Joe",
                    "steps": [
                      {
                        "player": "Can you tell me where I could find Smokin' Joe?"
                      },
                      {
                        "npc": "He should be in Keldagrim, the city of the dwarves."
                      },
                      {
                        "npc": "Tell him I said hello, will you? I've been meaning to catch up."
                      }
                    ]
                  },
                  {
                    "text": "The Face",
                    "steps": [
                      {
                        "player": "Can you tell me where I could find 'The Face'?"
                      },
                      {
                        "npc": "She'll be in Port Sarim, scaring people away from the entrance to the pits."
                      }
