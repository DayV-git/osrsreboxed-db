    "standard-dialogue": [
      {
        "player": "Hey, who are you?"
      },
      {
        "npc": "I'm Nigel. It is my job to tell you about Deadman Mode."
      },
      {
        "type": "choice",
        "options": [
          {
            "text": "Could you grant me access to Deadman: Annihilation?",
            "steps": [
              {
                "player": "Could you grant me access to Deadman: Annihilation?"
              },
              {
                "npc": "Well, yes, but there's some information you're going to want first."
              },
              {
                "type": "message",
                "text": "Deadman: Annihilation is a temporary event. All progress made will be transferred to Permanent Deadman Mode upon its conclusion.",
                "id": "3g1N8f"
              },
              {
                "type": "message",
                "text": "To use this account in Deadman: Annihilation, you will need to forfeit ALL progress associated with it in Permanent Deadman.",
                "id": "7YkafR"
              },
              {
                "type": "message",
                "text": "This includes all of your stats and items and this process is irreversible. Your main save will be unaffected.",
                "id": "NGgUQD"
              },
              {
                "type": "message",
                "text": "Afterwards, you will be able to play on Deadman: Annihilation worlds until their conclusion on the 21st of February, at which point your progress will be converted for use in Permanent Deadman.",
                "id": "2dFMov"
              },
              {
                "npc": "Now, if you wouldn't mind signing a few waivers..."
              },
              {
                "type": "choice",
                "options": [
                  {
                    "text": "Yes.",
                    "steps": [
                      {
                        "type": "choice",
                        "prompt": "To do so, I accept the fact that I will lose all my stats and items.",
                        "options": [
                          {
                            "text": "Yes.",
                            "steps": [
                              {
                                "type": "choice",
                                "prompt": "I know that I will be unable to get those stats and items back.",
                                "options": [
                                  {
                                    "text": "Yes.",
                                    "steps": [
                                      {
                                        "type": "choice",
                                        "prompt": "I accept the fact that I will lose any HiScores I have set.",
                                        "options": [
                                          {
                                            "text": "Yes.",
                                            "steps": [
                                              {
                                                "type": "choice",
                                                "prompt": "I am fine with losing access to Permanent Deadman worlds for now.",
                                                "options": [
                                                  {
                                                    "text": "Yes.",
                                                    "steps": [
                                                      {
                                                        "npc": "Very well. To complete your conversion, you will need to switch to a Deadman: Annihilation world."
                                                      },
                                                      {
                                                        "npc": "If you leave Lumbridge, speak to me again, or log back in to a Permanent Deadman world, your account conversion will be cancelled."
                                                      },
                                                      {
                                                        "npc": "And yes, I'm making you choose a world yourself. This is a big decision, you know!"
                                                      }
                                                    ]
                                                  },
                                                  {
                                                    "text": "No.",
                                                    "steps": []
                                                  }
                                                ]
                                              }
                                            ]
                                          },
                                          {
                                            "text": "No.",
                                            "steps": []
                                          }
                                        ]
                                      }
                                    ]
                                  },
                                  {
                                    "text": "No.",
                                    "steps": []
                                  }
                                ]
                              }
                            ]
                          },
                          {
                            "text": "No.",
                            "steps": []
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "text": "No.",
                    "steps": []
                  }
                ]
              }
            ]
          },
          {
            "text": "I have a question about Deadman mode.",
            "steps": [
              {
                "player": "I have a question about Deadman mode."
              },
              {
                "npc": "What would you like to know?"
              },
              {
                "type": "choice",
                "options": [
                  {
                    "text": "What is Deadman mode?",
                    "steps": [
                      {
                        "player": "What is Deadman mode?"
                      },
                      {
                        "npc": "Deadman mode is an incredibly dangerous survival game mode. Anyone can attack anyone, anywhere. Death comes at a huge cost and killing other players can be extremely lucrative."
                      },
                      {
                        "player": "Lucrative, you say?"
                      },
                      {
                        "npc": "Killing a player will earn you all of the items they had on them, plus the 10 most valuable items from their bank. The unfortunate soul will also lose half of their experience in most skills, or a quarter if they were not skulled. Regardless, it's quite the set-back."
                      },
                      {
                        "player": "Wow, that is brutal!"
                      },
                      {
                        "npc": "It is, but it is no simple task to kill someone in Deadman mode."
                      },
                      {
                        "npc": "Very high level guards patrol every major city and bank. They will kill anyone who has a skull. Getting yourself a kill is only half the battle."
                      },
                      {
                        "type": "jump",
                        "reference": "initial",
                        "id": "L34hKN"
                      }
                    ]
                  },
                  {
                    "text": "How do I play Deadman mode?",
                    "steps": [
                      {
                        "player": "How do I play Deadman mode?"
                      },
                      {
                        "npc": "You can log into Deadman mode by selecting a Deadman mode world from the world list before you log in."
                      },
                      {
                        "player": "So I don't need a new account to play Deadman mode?"
                      },
                      {
                        "npc": "Nope! You can use your existing account on a Deadman world, providing you have membership."
                      },
                      {
                        "player": "Do my stats and items transfer over to Deadman mode?"
                      },
                      {
                        "npc": "No, they do not. Your Deadman mode progress is completely separate from normal Old School worlds."
                      },
                      {
                        "type": "jump",
                        "reference": "initial",
                        "id": "t_t0Io"
                      }
                    ]
                  },
                  {
                    "text": "What happens when I die in Deadman mode?",
                    "steps": [
                      {
                        "player": "What happens when I die in Deadman mode?"
                      },
                      {
                        "npc": "If you die to a player you will lose the 10 most valuable stacks of items from your bank, all items that you have on your person and half of the experience you have gained in any unprotected skills."
                      },
                      {
                        "npc": "If you die to a monster when you have a PK skull you will lose the 10 most valuable stacks of items from your bank, all items that you have on your person and half of the experience you have gained in any unprotected skills."
                      },
                      {
                        "npc": "If you die to a monster when you do not have a PK skull you will lose all of the items on your person except for the 3 most valuable. You will not lose experience or any items from your bank."
                      },
                      {
                        "type": "jump",
                        "reference": "initial",
                        "id": "YG2Q6B"
                      }
                    ]
                  },
                  {
                    "text": "What happens when I kill a player in Deadman mode?",
                    "steps": [
                      {
                        "player": "What happens when I kill a player in Deadman mode?"
                      },
                      {
                        "npc": "When you kill a player you will receive any items they have on their person and you will also be given a key. You can use this key on Deadman chests found in various banks across the map. Within the chest you will"
                      },
                      {
                        "npc": "find the 10 most valuable stacks of items from the bank of the player you struck down. From here you will be able to choose the items you would like to keep."
                      },
                      {
                        "type": "jump",
                        "reference": "initial",
                        "id": "rFO9yw"
                      }
                    ]
                  },
                  {
                    "text": "More options...",
                    "steps": [
                      {
                        "type": "choice",
                        "options": [
                          {
                            "text": "How can I protect my items in Deadman mode?",
                            "steps": [
                              {
                                "player": "How can I protect my items in Deadman mode?"
                              },
                              {
                                "npc": "You can protect up to 10 items by placing them in your safe deposit box. Items in your safe deposit box will not be lost to a player who kills you, unlike those found in your bank. Remember that you can only place 10 single items into your safe deposit box, no stacks."
                              },
                              {
                                "type": "jump",
                                "reference": "initial",
                                "id": "gKQps4"
                              }
                            ]
                          },
                          {
                            "text": "How can I protect my stats in Deadman mode?",
                            "steps": [
                              {
                                "player": "How can I protect my stats in Deadman mode?"
                              },
                              {
                                "npc": "You can protect your levels in up to 2 combat skills and 3 non-combat skills. You can choose which by opening your items lost on death interface found in your equipment tab. Choose wisely!"
                              },
                              {
                                "npc": "You should be warned however. If you get killed by a guard, you will lose a tenth of your experience in those skills too!"
                              },
                              {
                                "npc": "Gelin over there also has some deals on insuring your hitpoints, speak to her to find out more about that."
                              },
                              {
                                "type": "jump",
                                "reference": "initial",
                                "id": "F24wRp"
                              }
                            ]
                          },
                          {
                            "text": "What are safe zones in Deadman mode?",
                            "steps": [
                              {
                                "player": "What are safe zones in Deadman mode?"
                              },
                              {
                                "npc": "Safe zones are areas patrolled by very high level guards which can be found in various places across the map. The guards watch out for any player with a PK skull and will attack them if they're spotted. It is still possible to be attacked inside safe zones but the person doing the attacking will not stand a chance of making it out alive."
                              },
                              {
                                "type": "jump",
                                "reference": "initial",
                                "id": "FEGQ_W"
                              }
                            ]
                          },
                          {
                            "text": "Previous options...",
                            "steps": [
                              {
                                "type": "jump",
                                "reference": "previous",
                                "id": "A_2Xjf"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
