  "variants": {
    "standard-dialogue": [
      {
        "npc": "Welcome to the farming guild. How may I help you?"
      },
      {
        "type": "choice",
        "options": [
          {
            "text": "Tell me about the guild.",
            "steps": [
              {
                "player": "Tell me about the guild."
              },
              {
                "npc": "After the Shayzien Army cleared out the lizardmen in this area, I founded this guild with some fellow Hosidius farmers."
              },
              {
                "player": "Why here? Why not within the safety of Kourend?"
              },
              {
                "npc": "The heat of the volcano allows us to grow things here that would never survive in the climate of Kourend. The discoveries we have made are worth the extra risk."
              },
              {
                "player": "Fair enough, anything else I should know about the guild?"
              },
              {
                "npc": "The guild is split into three tiers, with only advanced farmers being allowed access to the upper echelons."
              },
              {
                "npc": "Would you like to hear more about one of the tiers?"
              },
              {
                "type": "choice",
                "options": [
                  {
                    "text": "Tell me about the beginner tier.",
                    "steps": [
                      {
                        "player": "Tell me about the beginner tier."
                      },
                      {
                        "npc": "In the beginner tier you can access farming patches for cacti, allotments, bushes and flowers. You'll also find some shops with useful farming supplies."
                      },
                      {
                        "npc": "Would you like to hear more about another tier?"
                      },
                      {
                        "type": "jump",
                        "reference": "other",
                        "id": "0VE7W4"
                      }
                    ]
                  },
                  {
                    "text": "Tell me about the intermediate tier.",
                    "steps": [
                      {
                        "player": "Tell me about the intermediate tier."
                      },
                      {
                        "npc": "In the intermediate tier you can access farming patches for herbs and trees. You'll also find the anima and hespori patches which are unique to this guild."
                      },
                      {
                        "npc": "Would you like to hear more about another tier?"
                      },
                      {
                        "type": "jump",
                        "reference": "other",
                        "id": "T7dNpq"
                      }
                    ]
                  },
                  {
                    "text": "Tell me about the advanced tier.",
                    "steps": [
                      {
                        "player": "Tell me about the advanced tier."
                      },
                      {
                        "npc": "In the advanced tier you can access farming patches for fruit trees and spirit trees. You'll also find the redwood and celastrus patches which are unique to this guild."
                      },
                      {
                        "npc": "Would you like to hear more about another tier?"
                      },
                      {
                        "type": "jump",
                        "reference": "other",
                        "id": "KewsaM"
                      }
                    ]
                  },
                  {
                    "text": "No thanks.",
                    "steps": [
                      {
                        "player": "No thanks."
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "text": "Tell me about yourself.",
            "steps": [
              {
                "player": "Tell me about yourself."
              },
              {
                "npc": "My name is Jane, and I am the founder of the Farming Guild."
              },
              {
                "npc": "Is there anything else I can help you with?"
              },
              {
                "type": "choice",
                "options": [
                  {
                    "text": "Tell me about the guild.",
                    "steps": [
                      {
                        "type": "jump",
                        "reference": "above",
                        "id": "AceIfQ"
                      }
                    ]
                  },
                  {
                    "text": "I'd like a farming contract.",
                    "condition": "If the player does not have a contract:",
                    "steps": [
                      {
                        "type": "jump",
                        "reference": "below",
                        "id": "m4-eRU"
                      }
                    ],
                    "id": "K_lqbk"
