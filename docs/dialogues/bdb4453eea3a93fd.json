                "steps": [
                  {
                    "npc": "Hey, [player name]!"
                  }
                ]
              },
              {
                "text": "Dialogue 2",
                "steps": [
                  {
                    "npc": "Excuse me, [player name]?"
                  }
                ]
              },
              {
                "text": "Dialogue 3",
                "steps": [
                  {
                    "npc": "Can you hear me, [player name]?"
                  }
                ]
              },
              {
                "text": "Dialogue 4",
                "steps": [
                  {
                    "npc": "I just need a herb, [player name]!"
                  }
                ]
              },
              {
                "text": "Dialogue 5",
                "steps": [
                  {
                    "npc": "I'll give you a free potion, [player name]!"
                  }
                ]
              }
            ]
