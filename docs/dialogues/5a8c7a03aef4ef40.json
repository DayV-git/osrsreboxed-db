      {
        "type": "random",
        "options": [
          {
            "text": "Dialogue 1",
            "steps": [
              {
                "npc": "Gah! Trolls everywhere. There's no escape!"
              },
              {
                "player": "You could just leave the mine."
              },
              {
                "npc": "Oh, I'd never thought of that."
              }
            ]
          },
          {
            "text": "Dialogue 2",
            "steps": [
              {
                "npc": "This place rocks!"
              },
              {
                "player": "No it doesn't, it stays perfectly still."
              },
              {
                "npc": "Bah! Be quiet, pedant."
              }
            ]
          },
          {
            "text": "Dialogue 3",
            "steps": [
              {
                "npc": "High hoe, high hoe!"
              },
              {
                "player": "Why are you singing about farming implements at altitude?"
              },
              {
                "npc": "I don't know, I've never thought about it. Ask my Dad, he taught me the song."
              }
            ]
          },
          {
            "text": "Dialogue 4",
            "steps": [
              {
                "player": "How's your prospecting going?"
              },
              {
                "npc": "Mine's going pretty well."
              },
              {
                "player": "..."
              },
              {
                "npc": "Mine? Mine...you get it?"
              },
              {
                "player": "Oh, I got it. That doesn't make it funny though."
              },
              {
                "npc": "Suit yourself."
              }
            ]
          },
          {
            "text": "Dialogue 5",
            "steps": [
              {
                "npc": "I've been here for two days straight. When I close my eyes I see rocks."
              },
              {
                "player": "Why would anyone stay here for so long?"
              },
              {
                "npc": "I fear the outside. I fear the big light."
              },
              {
                "player": "Oh dear. Being underground for so long may have driven you mad."
              }
            ]
          },
          {
            "text": "Dialogue 6",
            "steps": [
              {
                "npc": "My back is killing me!"
              },
              {
                "player": "Could be worse, it could be the trolls killing you."
              },
              {
                "npc": "How very droll."
              },
              {
                "player": "No, troll."
              },
              {
                "npc": "Bah! I resist your attempts at jollity."
              }
            ]
          }
        ]
      }
    ]
  }
