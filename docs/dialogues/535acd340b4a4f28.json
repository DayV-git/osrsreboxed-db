    "before-starting-the-fremennik-trials-rellekka": [
      {
        "player": "Hello there."
      },
      {
        "npc": "Hey there, buddy. You're an outerlander, huh? I'm not really supposed to talk to you."
      },
      {
        "player": "Why not?"
      },
      {
        "npc": "I dunno buddy. Some stupid tradition or other. We're always told not to talk to outerlanders unless the Chieftain has allowed it."
      },
      {
        "player": "The Chieftain? Who is that?"
      },
      {
        "npc": "His names Brundt, buddy. He's a real boring guy. You can find him in the longhall there."
      },
      {
        "player": "Can you take me to see him?"
      },
      {
        "npc": "Sorry buddy, I'm not allowed into the Longhall. Don't worry, he's easy to spot. He's the one in the fancy helmet. Oh, and he only has one eye."
      },
      {
        "player": "He's a cyclops?"
      },
      {
        "npc": "Nah, nah, nah... He just wears an eyepatch! Well, see ya around buddy!"
      }
    ],
