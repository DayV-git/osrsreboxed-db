                },
                {
                  "text": "Pickaxes.",
                  "steps": [
                    {
                      "type": "choice",
                      "options": [
                        {
                          "text": "Bronze, Iron and Steel.",
                          "steps": [
                            {
                              "type": "message",
                              "text": "The Bronze Pick is your basic tool of the trade. You can buy one from Bob's Axe shop very cheaply, that's north of here in Lumbridge, I also heard that exploring the castle walls may yield a surprise or two.",
                              "id": "qck5Ff"
                            },
                            {
                              "type": "message",
                              "text": "The Iron and Steel Picks are faster than the bronze pickaxe, but you will need to progress with your mining a little before you can use them. You can buy them from Nurmof in the Dwarven mines.",
                              "id": "ulGeDh"
                            },
                            {
                              "type": "jump",
                              "reference": "previous",
                              "id": "DG0AEG"
                            }
                          ]
                        },
                        {
                          "text": "Mithril, Adamantite and Runite.",
                          "steps": [
                            {
                              "type": "message",
                              "text": "Mithril, Adamantite, and Rune Picks may be used as you progress with your skill of mining. They can be obtained from Nurmof in the Dwarven mines.",
                              "id": "02D1CP"
                            },
                            {
                              "type": "jump",
                              "reference": "previous",
                              "id": "6xqUw3"
                            }
                          ]
                        },
                        {
                          "text": "Teach me about mining.",
                          "steps": [
                            {
                              "type": "jump",
                              "reference": "initial",
                              "id": "4tbtY9"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
