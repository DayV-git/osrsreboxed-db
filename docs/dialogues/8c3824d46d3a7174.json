  "steps": [
    {
      "type": "choice",
      "options": [
        {
          "text": "Can you teach me the basics of mining please?",
          "condition": "If the player has level 1-24 Mining",
          "steps": [
            {
              "player": "Can you teach me the basics of mining please?"
            },
            {
              "type": "message",
              "text": "Look for this icon on your minimap to find mining rocks.",
              "id": "TOBzlM"
            },
            {
              "type": "condition",
              "text": "If the player does not have a pickaxe equipped or in the inventory:",
              "steps": [
                {
                  "npc": "As you're already here, have a pick so that you can mine the rocks around me."
                },
                {
                  "type": "action",
                  "action": "receive",
                  "text": "a bronze pickaxe",
                  "id": "yGblYo"
                },
                {
                  "type": "jump",
                  "reference": "continue",
                  "id": "-TEZMl"
                }
              ],
              "id": "LFXuEc"
            },
            {
              "type": "condition",
              "text": "If the player does not have a pickaxe equipped or in the inventory and has no inventory space:",
              "steps": [
                {
                  "npc": "I'd give you a pick to mine the rocks around me, but you don't have room in your inventory."
                },
                {
                  "type": "jump",
                  "reference": "continue",
                  "id": "5WK-fC"
                }
              ],
              "id": "rxEwoH"
            },
            {
              "type": "condition",
              "text": "If the player has a pickaxe equipped or in the inventory:",
              "steps": [
                {
                  "npc": "As you already have a pick, you can mine the rocks around me."
                },
                {
                  "type": "jump",
                  "reference": "continue",
                  "id": "6KQVu7"
                }
              ],
              "id": "S2yWNe"
            },
            {
              "npc": "You can tell the ore you'll get from a rock by looking at it. The colour of the rock helps, too."
            },
            {
              "npc": "To mine, simply click on the rock to mine it, while you've got a pickaxe with you."
            },
            {
              "npc": "When you have a full inventory, take it to the bank. There's a bank on the roof of the castle in Lumbridge."
            },
            {
              "type": "message",
              "text": "Look for this symbol on your minimap after climbing the stairs of the Lumbridge Castle to the top.",
              "id": "SpBZZA"
            },
            {
              "type": "jump",
              "reference": "initial",
              "id": "u7YfB1"
            }
          ],
          "id": "dwqFcz"
        },
