                                              "type": "jump",
                                              "reference": "initial",
                                              "id": "9uvyGc"
                                            }
                                          ]
                                        },
                                        {
                                          "text": "Teach me about different rocks.",
                                          "steps": [
                                            {
                                              "type": "jump",
                                              "reference": "previous2",
                                              "id": "blrgni"
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "text": "Teach me about mining.",
                                  "steps": [
                                    {
                                      "type": "jump",
                                      "reference": "initial",
                                      "id": "OE60Sg"
                                    }
                                  ]
                                },
                                {
                                  "text": "Back...",
                                  "steps": [
                                    {
                                      "type": "jump",
                                      "reference": "previous",
                                      "id": "2RZ8D3"
                                    }
                                  ]
                                }
                              ]
