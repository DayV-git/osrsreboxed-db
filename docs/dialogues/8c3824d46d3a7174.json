                              "reference": "initial",
                              "id": "gNwdDd"
                            }
                          ]
                        },
                        {
                          "text": "More...",
                          "steps": [
                            {
                              "type": "choice",
                              "options": [
                                {
                                  "text": "Silver and Gold.",
                                  "steps": [
                                    {
                                      "type": "message",
                                      "text": "Silver can be mined to help you with your crafting. You can find it in the Crafting guild, Al Kharid and many other mines.",
                                      "id": "3nkR35"
                                    },
                                    {
                                      "type": "message",
                                      "text": "Gold requires quite a lot of experience in mining before you can successfully extract it from the rocks. It can be found in Al Kharid, the Crafting guild, Rimmington and other places.",
                                      "id": "vfe-8C"
                                    },
                                    {
                                      "type": "choice",
                                      "options": [
                                        {
                                          "text": "Teach me about mining.",
                                          "steps": [
