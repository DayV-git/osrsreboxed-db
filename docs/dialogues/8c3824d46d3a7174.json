                                              "type": "jump",
                                              "reference": "initial",
                                              "id": "TQfgYd"
                                            }
                                          ]
                                        },
                                        {
                                          "text": "Teach me about different rocks.",
                                          "steps": [
                                            {
                                              "type": "jump",
                                              "reference": "previous2",
                                              "id": "S4NWLt"
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "text": "Mithril, Adamantite and Runite.",
                                  "steps": [
                                    {
                                      "type": "message",
                                      "text": "Mithril and Adamantite rocks are fairly rare and require great skill to mine. You can find them in Al Kharid, the Dwarven mines, Lumbridge Swamps and other places.",
                                      "id": "9YnJ7b"
                                    },
                                    {
                                      "type": "message",
                                      "text": "Runite is the most prized of ores and is very rare. I'll leave you to find where to mine it.",
                                      "id": "hdClYi"
                                    },
                                    {
                                      "type": "choice",
                                      "options": [
                                        {
                                          "text": "Teach me about mining.",
                                          "steps": [
