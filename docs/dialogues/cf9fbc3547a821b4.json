    "standard-dialogue-during-regicide-talking-to-ilfeen-at-the-earliest-opportunity-after-starting-regicide": [
      {
        "npc": "Good day, what are you doing all the way out here?"
      },
      {
        "player": "I'm just wandering, it's a lovely day for a walk in the woods."
      },
      {
        "npc": "It is that."
      },
      {
        "player": "Well I shouldn't keep you, see you later."
      },
      {
        "npc": "Bye."
      }
    ],
    "standard-dialogue-after-completing-the-eyes-of-glouphrie-before-starting-roving-elves": [
      {
        "player": "Do you remember Oaknock? He was a gnome inventor."
      },
      {
        "npc": "Of course! How is the young gnome? I rather liked him he was rather loud, but he had a good soul, and was very interested in elven magic."
      },
      {
        "player": "I think Oaknock died of old age some time ago. He must have visited you a few hundred years ago though..."
      },
      {
        "npc": "I keep forgetting, a hundred years is a long time for you. He was very interested in illusion magic, and how to prevent it. I gave him some advice and a few bits of equipment to help him."
      },
      {
        "player": "A seed?"
      },
      {
        "npc": "Of course. It grew into an axe. I hope he found it useful."
      },
      {
        "player": "I think he did! Thanks."
      },
      {
        "type": "message",
        "text": "Ilfeen smiles serenely.",
        "id": "YRuKmj"
      }
    ],
    "standard-dialogue-during-roving-elves": [
      {
        "player": "Hello."
      },
      {
        "npc": "Hey, how's it going?"
      },
      {
        "player": "Not bad, I'm trying to help an elf named Islwyn consecrate his grandmother's resting place. Do you know of anything that could help me?"
      },
      {
        "npc": "Sorry, I know nothing of the consecration process. Eluned will know though, she travels with Islwyn."
      },
      {
        "player": "Alright, thanks."
      },
      {
        "npc": "No problem."
      },
      {
