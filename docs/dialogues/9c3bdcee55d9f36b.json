{
  "steps": [
    {
      "npc": "Welcome to the Burrow, hunter."
    },
    {
      "player": "Thanks! It's nice and homely in here, isn't it?"
    },
    {
      "npc": "Quite! It's a good break from the city."
    },
    {
      "type": "choice",
      "options": [
        {
          "text": "How long have you been around here?",
          "steps": [
            {
              "player": "How long have you been around here?"
            },
            {
              "npc": "Not too long, in fact. Gilman invited me to join the guild a short while ago."
            },
            {
              "player": "What were you up to before that?"
            },
            {
              "npc": "Oh... A little bit of this and that."
            },
            {
              "player": "Nothing particularly interesting?"
            },
            {
              "npc": "You could say that... I'm definitely not proud of it."
            },
            {
              "type": "choice",
              "options": [
                {
                  "text": "Can I get a rumour?",
                  "steps": [
                    {
                      "type": "jump",
                      "reference": "below",
                      "id": "BdJgcq"
                    }
                  ]
                },
                {
                  "text": "See you later.",
                  "steps": [
                    {
                      "player": "See you later."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Can I get a rumour?",
          "steps": [
            {
              "player": "Can I get a rumour?"
            },
            {
              "type": "condition",
              "text": "If the player has not talked to Verity:",
              "steps": [
                {
                  "npc": "You're new here, aren't you? You might want to talk to Verity before you get started."
                },
                {
                  "type": "end"
                }
              ],
              "id": "J1S0Wy"
            },
            {
              "type": "condition",
              "text": "If the player does not have a rumour:",
              "steps": [
                {
                  "type": "random",
                  "options": [
                    {
                      "text": "Dialogue 1",
                      "steps": [
                        {
                          "npc": "Could you check out the validity of this report for me? Someone thinks they've seen a [creature]. Once you find it, bring back one of its [rare parts]."
                        },
                        {
                          "type": "end"
                        }
                      ]
                    },
                    {
                      "text": "Dialogue 2",
                      "steps": [
                        {
                          "npc": "There's been rumours of a rare [creature] coming in. Once you find it, bring back one of its [rare parts]."
                        },
                        {
                          "type": "end"
                        }
                      ]
                    },
                    {
                      "text": "Dialogue 3",
                      "steps": [
                        {
                          "npc": "We've got reports of a slightly different [creature] in the local population. Once you find it, bring back one of its [rare parts]."
                        },
                        {
                          "type": "end"
                        }
                      ]
                    },
                    {
                      "text": "Dialogue 4",
                      "steps": [
                        {
                          "npc": "Looks like we need some information on a unique specimen amongst the local [creature] population. Once you find it, bring back some of its [rare parts]."
                        },
                        {
                          "type": "end"
                        }
                      ]
                    },
                    {
                      "text": "Dialogue 5",
                      "steps": [
                        {
                          "npc": "I've heard rumours of a strange [creature] that you could check out for me. Once you find it, bring back one of its [rare parts]."
                        },
                        {
                          "type": "end"
                        }
                      ]
                    }
                  ]
                }
              ],
              "id": "7Yq3yX"
            },
            {
              "type": "condition",
              "text": "If the player has completed a rumour:",
              "steps": [
                {
                  "type": "condition",
                  "text": "If the player used the Talk option:",
                  "steps": [
                    {
                      "npc": "Verity will be glad to have another one ticked off. Thanks. Here's your reward."
                    },
                    {
                      "npc": "Fancy taking on another?"
                    },
                    {
                      "type": "jump",
                      "reference": "continue",
                      "id": "asT_mE"
                    }
                  ],
                  "id": "29emWG"
                },
                {
                  "type": "condition",
                  "text": "If the player used the Quick-Rumour option:",
                  "steps": [
                    {
                      "npc": "Thanks for that. I'll mark off that report for you. Would you like another rumour?"
                    },
                    {
                      "type": "jump",
                      "reference": "continue",
                      "id": "FEhk-X"
                    }
                  ],
                  "id": "7fgYfv"
                },
                {
                  "type": "choice",
                  "prompt": "Get another rumour?",
                  "options": [
                    {
                      "text": "Yes.",
                      "steps": [
                        {
                          "type": "jump",
                          "reference": "above",
                          "id": "eBjtyH"
                        }
                      ]
                    },
                    {
                      "text": "No.",
                      "steps": [
                        {
                          "type": "jump",
                          "reference": "initial",
                          "id": "HbsjC4"
                        }
                      ]
                    }
                  ]
                }
              ],
              "id": "w7HGfG"
            },
            {
              "type": "condition",
              "text": "If the player has a rumour:",
              "steps": [
                {
                  "npc": "You're hunting for me at the moment. This rumour was about a [creature]. You'll need to bring back some of its [rare parts]."
                }
              ],
              "id": "cv_bBg"
            },
            {
              "type": "condition",
              "text": "If the player has a rumour with a different Guild Hunter:",
              "steps": [
                {
                  "npc": "I hear you're hunting for [Guild Hunter]. Aren't you looking for a [creature] at the moment? You'll need to bring back some of its [rare parts]."
                },
                {
                  "npc": "Unless you fancy hunting for me instead?"
                },
                {
                  "type": "choice",
                  "prompt": "Switch to Guild Hunter Ornus (Adept)'s rumour?",
                  "options": [
                    {
                      "text": "Yes.",
                      "steps": [
                        {
                          "type": "condition",
                          "text": "If the player previously had an unfinished rumour with this Guild Hunter:",
                          "steps": [
                            {
                              "npc": "Oh, I remember! I asked you to hunt a [creature] and bring back its [rare parts]. I hope it's going okay!"
                            }
                          ],
                          "id": "ANJ7W-"
                        },
                        {
                          "type": "condition",
                          "text": "If the player can receive a new rumour with this Guild Hunter:",
                          "steps": [
                            {
                              "type": "jump",
                              "reference": "above",
                              "id": "EEmYfy"
                            }
                          ],
                          "id": "ge4uPa"
                        }
                      ]
                    },
                    {
                      "text": "No.",
                      "steps": [
                        {
                          "type": "end"
                        }
                      ]
                    }
                  ]
                }
              ],
              "id": "ProA1a"
            },
            {
              "type": "condition",
              "text": "If the player has asked Huntmaster Gilman for a brand new rumour:",
              "steps": [
                {
                  "type": "random",
                  "options": [
                    {
                      "text": "Dialogue 1",
                      "steps": [
                        {
                          "npc": "Heard we're having an intel reshuffle. You should probably focus on your current task for now."
                        }
                      ]
                    },
                    {
                      "text": "Dialogue 2",
                      "steps": [
                        {
                          "npc": "Gilman said that you're doing some work for him right now. I won't interfere with that."
                        }
                      ]
                    },
                    {
                      "text": "Dialogue 3",
                      "steps": [
                        {
                          "npc": "We're all having a rest, but don't you have something to be getting on with?"
                        }
                      ]
                    }
                  ]
                }
              ],
              "id": "aKPp-q"
            }
          ]
        },
        {
          "text": "Never mind.",
          "steps": [
            {
              "player": "Never mind."
            }
          ]
        }
      ]
    }
  ]
}
