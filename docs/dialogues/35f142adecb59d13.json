    "standard-dialogue-north-ferryman": [
      {
        "npc": "Want to cross the river? It's just 2 gold pieces!"
      },
      {
        "type": "choice",
        "options": [
          {
            "text": "Yes please.",
            "steps": [
              {
                "player": "Yes please."
              },
              {
                "type": "condition",
                "text": "If the player has 2 coins:",
                "steps": [
                  {
                    "type": "message",
                    "text": "The dwarf ferries you across the river.",
                    "id": "dvraEN"
                  },
                  {
                    "type": "end"
                  }
                ],
                "id": "5O4XPs"
              },
              {
                "type": "condition",
                "text": "If the player doesn't have 2 coins:",
                "steps": [
                  {
                    "npc": "You don't even have 2 gold coins, human!"
                  },
                  {
                    "npc": "Come back later."
                  },
                  {
                    "player": "But... that means I'm stuck here."
                  },
                  {
                    "npc": "Hmm. I suppose I could make an exception for you this time."
                  },
                  {
                    "type": "condition",
                    "text": "If the player has exactly 1 coin:",
