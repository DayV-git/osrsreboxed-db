    "historical-dialogue-south-ferryman-standard-dialogue": [
      {
        "npc": "Hello there, want a ride?"
      },
      {
        "player": "A ride, where to?"
      },
      {
        "npc": "Across the river, across the river! It's just a short ride!"
      },
      {
        "player": "How much will that cost me?"
      },
      {
        "npc": "Haha, you understand us dwarves well, human!"
      },
      {
        "npc": "It's just 2 gold pieces! Want to go?"
      },
      {
        "type": "choice",
        "options": [
          {
            "text": "I'd like to go further downstream.",
            "steps": [
              {
                "player": "I'd like to go further downstream."
              },
              {
                "npc": "You mean to the city of Keldagrim?"
              },
              {
                "player": "Ehm, yes, I think so."
              },
              {
                "npc": "Sorry, I'm just a simple ferryman, I only go across."
              },
              {
                "npc": "But talk to my friend here, he sometimes goes to the city in his ship."
              },
              {
                "player": "Thanks."
              }
            ]
          },
          {
            "text": "Yes please.",
            "steps": [
              {
                "type": "condition",
