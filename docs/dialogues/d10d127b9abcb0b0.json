    "standard-dialogue": [
      {
        "npc": "Good day."
      },
      {
        "type": "choice",
        "options": [
          {
            "text": "Who are you?",
            "steps": [
              {
                "player": "Who are you?"
              },
              {
                "npc": "My name is Clerk. I work on gathering people together to form what we call clans."
              },
              {
                "type": "choice",
                "options": [
                  {
                    "text": "What do you do here?",
                    "steps": [
                      {
                        "type": "jump",
                        "reference": "below",
                        "id": "5-z6DP"
                      }
                    ]
                  },
                  {
                    "text": "What is a clan?",
                    "steps": [
                      {
                        "player": "What is a clan?"
                      },
                      {
                        "npc": "Ah, clans. Where do I begin? Clans are groups of people gathered together for numerous reasons. Usually they have shared interests, like activities they enjoy together."
                      },
                      {
                        "npc": "These activities could include improving certain skills, battling the same monsters, or even battling other clans!"
                      },
                      {
                        "npc": "Other clans form together because they just enjoy the company of other like-minded people. The clan community can be a great resource if you should ever need help with anything."
                      },
                      {
                        "type": "choice",
                        "options": [
                          {
                            "text": "How do I join a clan?",
                            "steps": [
                              {
                                "player": "How do I join a clan?"
                              },
                              {
                                "npc": "You can either form your own clan with your friends, or apply to an already existing clan."
                              },
                              {
                                "npc": "Should you choose to form your own clan you will need four friends to join you, and it is recommended that you have spent a good amount of time in this world first. Leadership is not for everyone."
                              },
                              {
                                "npc": "However, fret not. There are plenty of interesting and exciting clans out there! Check out the clan recruitment board to see which clans are currently accepting applications."
                              },
                              {
                                "npc": "You can either form your own clan with your friends, or apply to an already existing clan."
                              }
                            ]
                          },
                          {
                            "text": "What can a clan offer me?",
                            "steps": [
                              {
                                "player": "What can a clan offer me?"
                              },
                              {
                                "npc": "Clans offer you the ability to have an official gathering of friends or like-minded individuals in a hierarchical structure."
                              },
                              {
                                "npc": "In other words, you and your friends get an exclusive chat channel and a Clan Hall, as well as the ability to assign ranks to members."
                              },
                              {
                                "npc": "Ranks can be assigned from custom pre-sets, which then determine what permissions that person has."
                              },
                              {
                                "npc": "For example: One person may have the rank to kick players from the chat, while another has the rank to access the Clan Coffer."
                              },
                              {
                                "type": "choice",
                                "options": [
                                  {
                                    "text": "What is the Clan Coffer?",
                                    "steps": [
                                      {
                                        "player": "What is the Clan Coffer?"
                                      },
                                      {
                                        "npc": "The Clan Coffer is a shared coin store, used by members of the clan. Highly ranked members can assign who has permission to deposit and withdraw coins."
                                      },
                                      {
                                        "type": "jump",
                                        "reference": "previous",
                                        "id": "GzrT3d"
                                      }
                                    ]
                                  },
                                  {
                                    "text": "What is a Clan Hall?",
                                    "steps": [
                                      {
                                        "player": "What is a Clan Hall?"
                                      },
                                      {
                                        "npc": "A Clan Hall is a private area only accessible for the people with the permission to enter. High ranked members of the clan can restrict it to only allow certain ranks in, or open it up to even allow guests."
                                      },
                                      {
                                        "player": "Why would I need a Clan Hall? Can't I get a house instead?"
                                      },
                                      {
                                        "npc": "The beauty of it is that you can have both. You can keep your house for private guests and your own personal use, but when you wish to see larger groups then the Clan Hall may be more fitting."
                                      },
                                      {
                                        "type": "jump",
                                        "reference": "initial",
                                        "id": "IHlW3t"
                                      }
                                    ]
                                  },
                                  {
                                    "text": "Goodbye.",
