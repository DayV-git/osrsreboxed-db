    "his-faithful-servants-miniquest-dialogue-talking-to-him-after-obtaining-the-strange-icon": [
      {
        "npc": "Icon?"
      },
      {
        "player": "Yes, I have it here."
      },
      {
        "npc": "At last! Quick! Give it!"
      },
      {
        "type": "message",
        "text": "You give the icon to the Strange Old Man.",
        "id": "riPo-7"
      },
      {
        "npc": "You did it! Now for me."
      },
      {
        "type": "message",
        "text": "Before you can react, the Strange Old Man casts a spell. The icon disintegrates in his hands.",
        "id": "Gn4hFy"
      },
      {
        "npc": "It's all little bits now."
      },
      {
        "player": "What? But why? I thought you needed it!"
      },
      {
        "npc": "Yes! Needed it for him, but not to keep! His friend asked him to protect it, but he made a new plan, a better plan!"
      },
      {
        "player": "What are you on about?"
      },
      {
        "npc": "The old plan is gone. We're not doing it that way. His friend won't be happy, but it was for the best!"
      },
      {
        "npc": "Now we're doing it his way..."
      },
      {
        "npc": "Anyway, job well done! Still more digging though. Always dig. Dig, dig, dig!"
      },
      {
        "npc": "Oh, and don't forget your prize! He made it very clear you had to have a prize!"
      },
      {
        "type": "message",
        "text": "The Strange Old Man gives you a lamp and a map.",
        "id": "nCxRpA"
      },
      {
        "player": "Thanks... I guess."
