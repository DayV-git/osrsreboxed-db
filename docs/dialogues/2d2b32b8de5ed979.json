    "his-faithful-servants-miniquest-dialogue": [
      {
        "npc": "It's time."
      },
      {
        "player": "Time for what?"
      },
      {
        "npc": "Time to dig. To dig, dig, dig. But no normal dig. We now have new purpose!"
      },
      {
        "player": "What do you mean? What purpose?"
      },
      {
        "npc": "The brothers six! Dutiful servants of Saradomin... At least, that's what they'd tell you! Ha! Not so. Not so."
      },
      {
        "npc": "They made a pact you see! Strength in life for servitude in death."
      },
      {
        "player": "Servitude?"
      },
      {
        "npc": "Yes! They guard it for him! That was their purpose, but that time is up now. He wants it back! You can get it! You can dig!"
      },
      {
        "player": "You want me to bring you something?"
      },
      {
        "npc": "The icon! He needs it now! You must dig, dig dig. Slay the brothers six! It's okay, it won't hurt them... much. The icon will be in the chest!"
      },
      {
        "player": "Right... So you want me to go and kill the six brothers and bring you back an icon?"
      },
      {
        "npc": "Yes! Do this! Do this! Maybe little prize for you if you do. But first you must dig! Dig, dig, dig!"
      },
      {
        "player": "Okay..."
      },
      {
        "type": "choice",
        "options": [
          {
            "text": "Can you tell me more about the brothers?",
            "steps": [
              {
                "player": "Can you tell me more about the brothers?"
              },
              {
                "type": "condition",
                "text": "If the player does not have the crumbling tome in their inventory:",
                "steps": [
                  {
                    "npc": "The brothers? His faithful servants! Book tell you more! Take it! I don't even want it!"
                  },
                  {
                    "type": "message",
                    "text": "The Strange Old Man gives you a book.",
                    "id": "2nqFUk"
                  },
                  {
                    "type": "end"
                  }
                ],
                "id": "NiEGlJ"
              },
              {
                "type": "condition",
                "text": "If the player has the crumbling tome in their inventory:",
                "steps": [
                  {
                    "npc": "The brothers? His faithful servants! Book tell you more! Read it! Read it!"
                  }
                ],
                "id": "z4HDJ1"
              }
            ]
