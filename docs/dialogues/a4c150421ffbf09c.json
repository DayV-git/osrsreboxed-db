    "standard-dialogue-during-making-friends-with-my-arm": [
      {
        "npc": "Hey, human."
      },
      {
        "type": "choice",
        "options": [
          {
            "text": "Who are you?",
            "steps": [
              {
                "player": "Who are you?"
              },
              {
                "npc": "I am Odd Stone. Got named after some odd stone thing I found in the snowfields south of Weiss."
              },
              {
                "player": "An odd stone thing?"
              },
              {
                "npc": "Yeah, it were made of stone, and it were odd. Some weird bone-head human saw me trying to nibble it, an' he got really upset an' chased me away. He kinda scary."
              },
              {
                "npc": "Anyway, my parents they named me Odd Stone after that, and now we trolls not go anywhere near the place. Bone-head human was, like, really scary! And probably magic."
              },
              {
                "type": "choice",
                "options": [
                  {
                    "text": "Can I go looking for the odd stone?",
                    "steps": [
                      {
                        "player": "Can I go looking for the odd stone?"
                      },
                      {
                        "npc": "No, we trolls blocked all routes to snowfields from here. Don't want scary bone-head human coming to Weiss."
                      },
                      {
                        "type": "action",
                        "text": "(Shows other initial options)",
                        "id": "nm54oT"
                      }
                    ]
                  },
                  {
                    "text": "Thanks, that's interesting.",
                    "steps": [
                      {
                        "player": "Thanks, that's interesting."
                      },
                      {
                        "type": "action",
                        "text": "(Shows other initial options)",
                        "id": "fs4kjv"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "text": "Tell me about this place.",
            "steps": [
              {
                "player": "Tell me about this place."
              },
              {
                "npc": "This here is Weiss. Trolls built it years ago, after we got kicked out from caves further south. Now Weiss is our home."
              },
              {
                "npc": "We done pretty good here. Got lots of goat and wolf to eat - they taste kinda boring after all this time, but there not much other choice."
              },
              {
                "type": "choice",
                "options": [
                  {
                    "text": "Ever tried goutweed?",
                    "steps": [
                      {
                        "player": "Ever tried goutweed? I know trolls who love it. In fact My Arm is an expert on growing the stuff."
                      },
                      {
                        "npc": "Never heard of no gouty weed, no. But it sound like a vegetable, an' Mother not like eating those, so we probably not gonna try it."
                      },
                      {
                        "npc": "Mother not like new ideas much, but he really big, an' he boss, so we do what he say."
                      },
                      {
                        "type": "action",
                        "text": "(Shows other initial options)",
                        "id": "I3dyad"
                      }
                    ]
                  },
                  {
                    "text": "I see.",
                    "steps": [
                      {
                        "player": "I see."
                      },
                      {
                        "type": "action",
                        "text": "(Shows other initial options)",
                        "id": "-gAlAZ"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "text": "Do you like it here?",
            "steps": [
              {
                "player": "Do you like it here?"
              },
              {
                "npc": "Eh, it kinda rough, but it our home. Odd Mushroom say he can make it nicer with fancy fires what he invented, but Mother not interested in that, so Odd Mushroom not allowed to do it."
              },
              {
                "npc": "Mother only care about stuff to help him fight better. An he really big, an' he boss, so we do what he say."
              },
              {
                "type": "jump",
                "reference": "other",
                "id": "GjMrA0"
              }
            ]
          },
          {
            "text": "I'll be off.",
            "steps": [
              {
                "player": "I'll be off."
              }
            ]
          }
        ]
      }
    ],
