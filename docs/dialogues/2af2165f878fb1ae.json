                  "steps": [
                    {
                      "npc": "Another one done? You're really doing a lot for the guild."
                    },
                    {
                      "npc": "Are you up for another?"
                    },
                    {
                      "type": "jump",
                      "reference": "continue",
                      "id": "kBEVrY"
                    }
                  ],
                  "id": "IQ1wMe"
                },
                {
                  "type": "condition",
                  "text": "If the player used the Quick-Rumour option:",
                  "steps": [
                    {
                      "npc": "Thanks for that. I'll mark off that report for you. Would you like another rumour?"
                    },
                    {
                      "type": "jump",
                      "reference": "continue",
                      "id": "YTFanU"
                    }
                  ],
                  "id": "GeycdO"
                },
                {
                  "type": "choice",
                  "prompt": "Get another rumour?",
                  "options": [
                    {
                      "text": "Yes.",
                      "steps": [
                        {
                          "type": "jump",
                          "reference": "above",
                          "id": "65Z6Ao"
                        }
                      ]
                    },
                    {
                      "text": "No.",
                      "steps": [
                        {
                          "type": "jump",
                          "reference": "initial",
                          "id": "75b_p-"
                        }
                      ]
                    }
                  ]
                }
              ],
              "id": "BZ9BuT"
            },
            {
              "type": "condition",
              "text": "If the player has a rumour:",
              "steps": [
                {
                  "player": "Can you remind me which rumour I'm chasing right now?"
                },
                {
                  "npc": "You're hunting for me at the moment. This rumour was about a [creature]. You'll need to bring back some of its [rare parts]."
                }
              ],
              "id": "hOgvx8"
            },
            {
              "type": "condition",
              "text": "If the player has a rumour with a different Guild Hunter:",
              "steps": [
                {
                  "npc": "I can see you're following [Guild Hunter]'s rumour looking for a [creature] at the moment. You'll need to bring back some of its [rare parts]."
                },
                {
                  "type": "condition",
                  "text": "If the player previously had an unfinished rumour with this Guild Hunter:",
                  "steps": [
                    {
                      "npc": "I seem to remember sending you off to hunt a [creature] and bring back one of its [rare parts]. Would you prefer that one, or a new one entirely?"
                    }
                  ],
                  "id": "zlCG2S"
                },
                {
                  "type": "choice",
                  "prompt": "Switch to Huntmaster Gilman (Novice)'s rumour?",
                  "options": [
                    {
                      "text": "Yes, go back to his old one.",
                      "steps": [
                        {
                          "npc": "That was it. I asked you to hunt a [creature] and bring back one of its [rare parts]. Best of luck."
                        }
                      ]
                    },
                    {
                      "text": "Yes, but with a brand new one.",
                      "steps": [
                        {
                          "type": "jump",
                          "reference": "above",
                          "id": "Ah9R1l"
                        }
                      ]
                    },
                    {
                      "text": "No.",
                      "steps": []
                    }
                  ]
                }
              ],
              "id": "ZR0mif"
            }
          ]
        },
        {
          "text": "I'm good, thanks.",
          "steps": [
            {
              "player": "I'm good, thanks."
