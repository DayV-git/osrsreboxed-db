    "standard-dialogue": [
      {
        "type": "action",
        "text": "The Demon butler bows",
        "action": "emote",
        "action_source": "text",
        "id": "QXE8zI"
      },
      {
        "npc": "Greetings! I am Alathazdrar, butler to the Demon Lords, and I offer thee my services for a mere 10000 coins!"
      },
      {
        "type": "choice",
        "options": [
          {
            "text": "What can you do?",
            "steps": [
              {
                "player": "What can you do?"
              },
              {
                "npc": "I have learned my trade under the leash of some of the harshest masters of the Demon Dimensions. I can cook to satisfy the most infernal stomachs, and fly on wings of flame to deposit thine items in the bank or bring"
              },
              {
                "npc": "planks from the sawmill in seconds."
              }
            ]
          },
          {
            "text": "Tell me about your previous jobs",
            "steps": [
              {
                "player": "Tell me about your previous jobs."
              },
              {
                "npc": "For millennia I have served and waited on the mighty Demon Lords of the Infernal Dimensions. I began as a humble footman in the household of Lord Thammaron, and for several centuries I was the private valet to"
              },
              {
                "npc": "Delrith. I have also worked in the Grim Underworld, escorting the souls of the dead to their final abodes. But the incessant shadows and hellfire weary me, so I have come to serve mortal masters in the realms of light."
              }
            ]
          },
          {
            "text": "You're hired!",
            "steps": [
              {
                "type": "condition",
                "text": "If the player does not have at least 50 Construction:",
                "steps": [
                  {
                    "npc": "You, a mere mortal with level [1-49] Construction, wish to employ ME, butler to Great Ones of the Outer Darkness? Ha ha ha! I refuse to work for anyone below level 50 Construction."
                  },
                  {
                    "type": "end"
                  }
                ],
                "id": "LKcSWX"
              },
              {
                "type": "condition",
                "text": "If the player has a servant already:",
                "steps": [
                  {
                    "type": "message",
                    "text": "You already have a servant.",
                    "id": "BdkrE7"
                  },
                  {
                    "type": "end"
                  }
                ],
                "id": "8aMg0I"
              },
              {
                "type": "condition",
                "text": "If the player does not have a second bedroom with a bed:",
                "steps": [
                  {
                    "type": "message",
                    "text": "You need a second bedroom with a bed for your servant to sleep in.",
                    "id": "hMnnvL"
                  },
                  {
                    "type": "end"
                  }
                ],
                "id": "b5lmIK"
              },
              {
                "type": "condition",
                "text": "If the player does not have enough money in their inventory:",
                "steps": [
                  {
                    "player": "You're hired... well, I don't have the money on me, but can I owe you? I'm good for it, honest."
                  },
                  {
                    "npc": "I regret, Master, that I must insist on payment up front."
                  },
                  {
                    "type": "end"
                  }
                ],
                "id": "5FjPNr"
              },
              {
                "type": "condition",
                "text": "If the player has the above conditions met and the player doesn't have a servant:",
                "steps": [
                  {
                    "player": "You're hired!"
                  },
                  {
                    "npc": "I shall devote my every art to thy service, my Master."
                  }
                ],
                "id": "U3-Zn8"
              }
            ]
          }
        ]
      }
    ],
