    "standard-dialogue-first-time-speaking-to-turael": [
      {
        "player": "Who are you?"
      },
      {
        "npc": "I'm one of the elite Slayer Masters."
      },
      {
        "type": "choice",
        "options": [
          {
            "text": "What's a slayer?",
            "steps": [
              {
                "player": "What's a slayer?"
              },
              {
                "npc": "Oh dear, what do they teach you in school?"
              },
              {
                "player": "Well... er..."
              },
              {
                "npc": "I suppose I'll have to educate you then. A slayer is someone who is trained to fight specific creatures. They know these creatures' every weakness and strength. As you can guess it makes killing them a lot easier."
              },
              {
                "type": "jump",
                "reference": "below",
                "id": "BMSYPo"
              }
            ]
          },
          {
            "text": "Never heard of you...",
            "steps": [
              {
                "player": "Never heard of you..."
              },
              {
                "npc": "That's because my foe never lives to tell of me. We slayers are a dangerous bunch."
              },
              {
                "type": "choice",
                "options": [
                  {
                    "text": "Wow, can you teach me?",
                    "steps": [
                      {
                        "player": "Wow, can you teach me?"
                      },
                      {
                        "npc": "Hmmm well I'm not so sure..."
                      },
                      {
                        "player": "Pleeeaasssse!"
                      },
                      {
                        "npc": "Oh okay then, you twisted my arm. You'll have to train against specific groups of creatures."
                      },
                      {
                        "player": "Okay, what's first?"
                      },
                      {
                        "npc": "We'll start you off hunting [monster name], you'll need to kill [number] of them."
                      },
                      {
                        "npc": "You'll also need this enchanted gem, it allows Slayer Masters like myself to contact you and update you on your progress. Don't worry if you lose it, you can buy another from any Slayer Master."
                      },
                      {
                        "type": "choice",
                        "options": [
                          {
                            "text": "Got any tips for me?",
                            "steps": [
                              {
                                "type": "action",
                                "text": "(Slayer task specific tip.)",
                                "id": "vhWgv1"
                              }
                            ]
                          },
                          {
                            "text": "Okay, great!",
                            "steps": [
                              {
                                "player": "Okay, great!"
                              },
                              {
                                "npc": "Good luck! Don't forget to come back when you need a new assignment."
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "text": "Sounds useless to me.",
                    "steps": [
                      {
                        "player": "Sounds useless to me."
                      },
                      {
                        "npc": "Suit yourself."
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ],
