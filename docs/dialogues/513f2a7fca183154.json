      {
        "type": "random",
        "options": [
          {
            "text": "Dialogue 1",
            "steps": [
              {
                "npc": "Slurp! You look positively delicious - let me help you lose a bit of weight! Either I get a bite or you can go to the mines; which is it to be, meat sack?"
