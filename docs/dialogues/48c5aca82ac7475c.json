    "starting-out-talking-to-the-cook": [
      {
        "player": "Can we talk about what happened in the dining room?"
      },
      {
        "type": "line",
        "speaker": "Cook",
        "text": "Wow! You were incredible! The way you defeated the Culinaromancer, you made it seem so easy!"
      },
      {
        "player": "So... I don't suppose you can remember how I defeated him can you?"
      },
      {
        "type": "line",
        "speaker": "Cook",
        "text": "Of course! Which bit can't you remember doing?"
      },
      {
        "type": "choice",
        "options": [
          {
            "text": "Protecting the Dwarf"
          },
          {
            "text": "Protecting the Goblins"
          },
          {
            "text": "Protecting the Pirate"
          },
          {
            "text": "Protecting the Lumbridge Guide",
            "steps": [
              {
                "player": "The Lumbridge guide... I can't really rememember what I did to save him..."
              },
              {
                "type": "line",
                "speaker": "Cook",
                "text": "Oh, you told me that that crazy wizard in the wizards' tower helped you with that."
              },
              {
                "player": "That crazy wizard at the wizards' tower? Was I not any more specific than that?"
              },
              {
                "type": "line",
                "speaker": "Cook",
                "text": "No, not really. I think you might have mentioned the name Traiborn though."
              },
              {
                "player": "Oh yeah... I remember now..."
              },
              {
                "type": "line",
                "speaker": "Cook",
                "text": "Did you want a reminder on any other of your brave exploits?"
              },
              {
                "type": "jump",
                "reference": "previous",
                "id": "rK7ObR"
              }
            ]
          },
          {
            "text": "Protecting Evil Dave"
          },
          {
            "text": "Protecting the Ogre"
          },
          {
            "text": "Protecting the Sir Amik Varze"
          },
          {
            "text": "Protecting the Monkey"
          },
          {
            "text": "Defeating the Culinaromancer"
          }
        ]
      }
    ],
    "the-quiz-talking-to-wizard-traiborn": [
      {
        "type": "line",
        "speaker": "Wizard Traiborn",
        "text": "Ello young thingummywut."
      },
      {
        "type": "choice",
        "options": [
          {
            "text": "Ask about helping the Lumbridge Guide.",
            "steps": [
              {
                "player": "Hi. I was wondering if you could help me?"
              },
              {
                "type": "line",
                "speaker": "Wizard Traiborn",
                "text": "You don't look like you have a problem."
              },
              {
                "player": "Well I do. I need to make something called a Cake of Guidance, and I was told that you could help me out."
              },
              {
                "type": "line",
                "speaker": "Wizard Traiborn",
                "text": "Mmmmm. Cake of Guidance. Yummy Yum! Did you know they're imbued with knowledge and information itself? When eaten it will give anyone the guidance they need to get back on track. So you say you're a chef?"
              },
              {
                "player": "Erm. No I don't think I did. I need to make that cake for the Lumbridge Guide. He's been frozen in time and needs help."
              },
              {
                "type": "line",
                "speaker": "Wizard Traiborn",
                "text": "Oh dear, it's a strange day when the Lumbridge Guide needs guidance. Don't worry, I shall help you make your chocolate cake."
              },
              {
                "player": "Not a chocolate cake - a CAKE OF GUIDANCE."
              },
              {
                "type": "line",
                "speaker": "Wizard Traiborn",
                "text": "Make up your mind!"
              },
              {
                "player": "I have. So what do I need to do?"
              },
              {
                "type": "line",
                "speaker": "Wizard Traiborn",
                "text": "You don't know? Deary me. You'll need to enchant three ingredients with your own knowledge. Bring me the basic ingredients and I will help you with the enchantment."
              },
              {
                "player": "What are the ingredients?"
              },
              {
                "type": "line",
                "speaker": "Wizard Traiborn",
                "text": "An eggy peggy, some floury woury and some milky wilky."
              },
              {
                "player": "So to the sane world, an egg, flour and milk. No problem, I'll be right back."
              },
              {
                "type": "line",
                "speaker": "Wizard Traiborn",
                "text": "Have a nice time!"
              },
              {
                "player": "...Thanks."
              }
            ]
          },
          {
            "text": "Talk about other issues."
          }
        ]
      }
    ],
