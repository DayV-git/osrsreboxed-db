                                      },
                                      {
                                        "npc": "We send launchers from our outpost to the nearby islands. If you go and wait in the lander there that'd really help."
                                      }
                                    ]
                                  },
                                  {
                                    "text": "Sorry, but I can't.",
                                    "steps": [
                                      {
                                        "player": "Sorry, but I can't."
                                      }
