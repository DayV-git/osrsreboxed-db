                "target": "Makeover Mage{{!}}Select skin colour and gender",
                "id": "jRCYhe"
              },
              {
                "type": "action",
                "text": "Player selects skin colour and/or gender",
                "id": "SUY-QA"
              },
              {
                "npc": "Huh, I knew the Makeover Mage said that would work, but I didn't actually believe them!"
