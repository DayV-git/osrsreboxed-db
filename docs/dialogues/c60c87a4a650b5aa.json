                          {
                            "type": "choice",
                            "options": [
                              {
                                "text": "Where do I need to go?",
                                "steps": [
                                  {
                                    "player": "Where do I need to go?"
                                  },
                                  {
                                    "npc": "The Arceuus station is just next to the Arceuus Library, in the north of the city."
                                  },
                                  {
                                    "npc": "The Shayzien station is east of the Shayzien Encampment."
                                  },
                                  {
                                    "npc": "The Hosidius station is north of the Woodcutting Guild."
                                  },
                                  {
                                    "npc": "The Piscarilius station is south of the city, next to a small mine."
                                  },
                                  {
                                    "npc": "The Quidamortem station is at the peak of the mountain, deep in the Kebos Lowlands."
                                  },
                                  {
                                    "type": "jump",
                                    "reference": "other",
                                    "id": "YRFA87"
                                  }
                                ]
                              },
                              {
                                "text": "Can I go for a ride now?",
                                "steps": [
                                  {
                                    "player": "Can I go for a ride now?"
                                  },
                                  {
                                    "npc": "No, you haven't unlocked any of the other stations yet."
                                  }
                                ]
                              },
                              {
                                "text": "Do I have to pay every time I use the carts?",
                                "steps": [
                                  {
                                    "player": "Do I have to pay every time I use the carts?"
                                  },
                                  {
                                    "npc": "Hmmm... We normally charge 50 coins per ride. For 100,000 coins, you'll never have to pay again."
                                  },
                                  {
                                    "type": "choice",
                                    "options": [
                                      {
                                        "text": "100,000 coins is a rip-off!",
                                        "steps": [
                                          {
                                            "player": "100,000 coins is a rip-off!"
                                          },
                                          {
                                            "npc": "Take it or leave it, human! You may enjoy being about to ride our carts without having to carry coins every time."
                                          },
                                          {
                                            "type": "jump",
                                            "reference": "other",
                                            "id": "9XgbR7"
                                          }
                                        ]
                                      },
                                      {
                                        "text": "Okay, I'll pay.",
                                        "steps": [
