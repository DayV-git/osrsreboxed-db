                "type": "jump",
                "reference": "other",
                "id": "l4pR0A"
              }
            ]
          },
          {
            "text": "Can I ride your minecart?",
            "steps": [
              {
                "player": "Can I ride your minecart?"
              },
              {
                "type": "condition",
                "text": "If the player has a full inventory:",
                "steps": [
                  {
                    "npc": "The network is for the citizens of Lovakengj only, though I'll let you use it if you help me first. Free up some inventory space if you're interested."
