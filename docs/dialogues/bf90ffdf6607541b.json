                        "id": "1YGw3u"
                      }
                    ]
                  },
                  {
                    "text": "Can I have a new essence pouch?",
                    "steps": [
                      {
                        "player": "Can I have a new essence pouch?"
                      },
                      {
                        "type": "condition",
                        "text": "If the player does not have a free inventory space:",
                        "steps": [
