                  {
                    "text": "Nothing, thanks.",
                    "steps": [
                      {
                        "player": "Nothing, thanks."
                      },
                      {
                        "npc": "Okay, no problem. See you again."
                      }
                    ]
                  }
                ]
              }
            ]
          },
