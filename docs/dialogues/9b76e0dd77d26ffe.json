    "viewing-the-telescope-another-time": [
      {
        "npc": "What do you see now?"
      },
      {
        "player": "I can see a constellation through the telescope. It looks like Scorpio."
      },
      {
        "npc": "Scorpio? Interesting. How very fitting."
      },
      {
        "player": "What do you mean?"
      },
      {
        "npc": "Scorpius, the founder of all we know relating to astronomy. There's a book about him in the reception. Perhaps you should check it out, you might learn something."
      },
      {
        "player": "Then perhaps I shall."
      }
