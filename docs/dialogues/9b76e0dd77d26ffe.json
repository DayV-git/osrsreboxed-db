    "standard-dialogue-after-observatory-quest": [
      {
        "npc": "Welcome back."
      },
      {
        "type": "choice",
        "options": [
          {
            "text": "Talk about the Observatory quest.",
            "steps": [
              {
                "npc": "Thanks for all your help with the telescope. What can I do for you?"
              },
              {
                "type": "choice",
                "options": [
                  {
                    "text": "Do you need any more help with the telescope?",
                    "steps": [
                      {
                        "npc": "Not right now,"
                      },
                      {
                        "npc": "but the stars may hold a secret for you."
                      }
                    ]
                  },
                  {
                    "text": "Is it true your name is Mambo-duna-roona?",
                    "condition": "If the player has asked the Observatory assistant about his real name:",
                    "steps": [
