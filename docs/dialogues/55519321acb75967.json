    "standard-dialogue-after-completing-ratcatchers": [
      {
        "type": "choice",
        "options": [
          {
            "text": "Can you tell me where I would find ....",
            "steps": [
              {
                "type": "choice",
                "options": [
                  {
                    "text": "Grimesquit and Phingspet",
                    "steps": [
                      {
                        "player": "Can you tell me where I could find Phingspet and Grimesquit?"
                      },
                      {
                        "npc": "Ah, the sisters Grime, as strange a pair as you're ever likely to meet."
                      },
                      {
                        "npc": "You'll find them in the sewers of Varrock."
                      }
                    ]
                  },
                  {
                    "text": "Jimmy Dazzler",
                    "steps": [
                      {
                        "player": "Can you tell me where I could find Jimmy Dazzler?"
                      },
                      {
                        "npc": "Ah, young Jimmy, he must be a made man by now."
                      },
                      {
                        "npc": "I remember when he was a lad..."
                      },
                      {
                        "player": "Do you remember where to find him, too?"
                      },
                      {
                        "npc": "Hrmph! His old waterin' hole was the Flying Horse in Ardougne."
                      }
                    ]
                  },
                  {
                    "text": "Hooknosed Jack",
                    "steps": [
                      {
                        "player": "Can you tell me where I could find Hooknosed Jack?"
                      },
                      {
                        "npc": "That old brawler? Is he still knockin' about?"
                      },
                      {
                        "npc": "Well, your best bet would be somewhere on the east side of Varrock. It's rough around there though, be careful."
                      }
                    ]
                  },
                  {
                    "text": "The Face",
                    "steps": [
                      {
                        "player": "Can you tell me where I could find 'The Face'?"
                      },
                      {
                        "npc": "You'll find her in Port Sarim."
                      }
                    ]
                  },
                  {
                    "text": "Felkrash",
                    "steps": [
                      {
                        "player": "Can you tell me where I could find Felkrash?"
                      },
                      {
                        "npc": "Ah, the boss herself. You'll probably find her in the Port Sarim rat pits."
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
