              {
                "player": "What is this place?"
              },
              {
                "npc": "This, me hearty, is the entrance to the Brimhaven Agility Arena!"
              },
              {
                "npc": "I were diggin for buried treasure when I found it! Amazed I was! It was a sight to behold!"
              },
              {
                "type": "line",
                "speaker": "Parrot",
                "text": "Buried treasure!"
