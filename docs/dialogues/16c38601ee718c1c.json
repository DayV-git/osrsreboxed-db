    "standard-dialogue-within-daimon-s-crater": [
      {
        "npc": "Hello, wanderer. How may I help you?"
      },
      {
        "type": "choice",
        "options": [
          {
            "text": "What is this place?",
            "steps": [
              {
                "player": "What is this place?"
              },
              {
                "npc": "This is Daimon's Crater. Once, it was home to a group of demons who set up a fortress inside this dormant volcano to mine rare minerals. However, their activity reactivated the volcano, resulting in their demise."
              },
              {
                "npc": "Years later, humans settled in the ruins. Convinced that they were the descendants of the demons, they began to hunt each other for fun."
              },
              {
                "npc": "Today, the crater is home to Bounty Hunter, a magnificent battle arena where you can engage in combat and test your mettle against skilled opponents."
              },
              {
                "type": "jump",
                "reference": "other",
                "id": "VUuBnj"
              }
            ]
          },
          {
            "text": "How do I play Bounty Hunter?",
            "condition": "After selecting other dialogue",
            "steps": [
              {
                "player": "How do I play Bounty Hunter?"
              },
              {
                "npc": "Before entering the arena, ensure that you have enough coins in your Coffer to participate. Upon entering, you will be assigned a Target to fight."
              },
              {
                "npc": "Locate your Targets and engage them in combat, defeating them to claim your reward."
              },
              {
                "player": "That sounds easy enough."
              },
              {
                "npc": "If you require further information about the Bounty Hunter, feel free to ask the Corrupted Warrior. They will be able to answer any questions you may have."
              },
              {
                "type": "jump",
                "reference": "other",
                "id": "r6fThI"
              }
            ],
            "id": "0WLIu4"
          },
          {
            "text": "What level Targets might I be assigned?",
            "steps": [
              {
                "player": "What level Targets might I be assigned?"
              },
              {
                "npc": "You may be assigned Targets up to [value] levels stronger than you."
              },
              {
                "type": "choice",
                "prompt": "Current maximum: [value] levels higher",
                "options": [
                  {
                    "text": "Set maximum to 5 levels higher",
                    "steps": [
                      {
                        "npc": "Very well, you may be assigned Targets up to 5 levels stronger than you. This range only applies to Targets, as Rogue fights will always have a range of 5 from your combat level."
                      }
                    ]
                  },
                  {
                    "text": "Set maximum to 10 levels higher",
                    "steps": [
                      {
                        "npc": "Very well, you may be assigned Targets up to 10 levels stronger than you. This range only applies to Targets, as Rogue fights will always have a range of 5 from your combat level."
                      }
                    ]
                  },
                  {
                    "text": "Set maximum to 15 levels higher",
                    "steps": [
                      {
                        "npc": "Very well, you may be assigned Targets up to 15 levels stronger than you. This range only applies to Targets, as Rogue fights will always have a range of 5 from your combat level."
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "text": "I'd like to manage my Coffer.",
            "steps": [
              {
                "player": "I'd like to manage my Coffer."
              },
              {
                "npc": "Do you want to add or remove coins from your coffer?"
              },
              {
                "type": "choice",
                "prompt": "Current coffer: [number of coins]",
                "options": [
                  {
                    "text": "Deposit coins."
                  },
                  {
                    "text": "Withdraw coins."
                  }
                ]
              }
            ]
          },
          {
            "text": "Let's trade for rewards.",
            "steps": [
              {
                "type": "action",
                "text": "Bounty Hunter Store opens",
                "action": "open_shop",
                "action_source": "text",
                "target": "Bounty Hunter Store",
                "id": "p_iSBT"
              }
            ]
          },
          {
            "text": "Can I have a PK skull, please?",
            "condition": "If the player is not skulled",
            "steps": [
              {
                "player": "Can I have a PK skull, please?"
              },
              {
                "type": "choice",
                "prompt": "A PK skull means you drop ALL your items on death.",
                "options": [
                  {
                    "text": "Give me a PK skull.",
                    "steps": [
                      {
                        "type": "message",
                        "text": "You are now skulled.",
                        "id": "fX1Wjn"
                      }
                    ]
                  },
                  {
                    "text": "Cancel.",
                    "steps": []
                  }
                ]
              }
            ],
            "id": "ivnIFq"
          },
          {
            "text": "Can you make my PK skull last longer?",
            "condition": "If the player is skulled",
            "steps": [
              {
                "player": "Can you make my PK skull last longer?"
              },
              {
                "type": "condition",
                "text": "If the skull can be extended:",
                "steps": [
                  {
                    "type": "choice",
                    "prompt": "Extend your PK skull duration?",
                    "options": [
                      {
                        "text": "Yes",
                        "steps": [
                          {
                            "type": "message",
                            "text": "Your PK skull will now last for the full 20 minutes.",
                            "id": "IWVXX4"
                          },
                          {
                            "type": "end"
                          }
                        ]
                      },
                      {
                        "text": "No",
                        "steps": [
                          {
                            "type": "end"
                          }
                        ]
                      }
                    ]
                  }
                ],
                "id": "CacJgB"
              },
              {
                "type": "condition",
                "text": "If the skull can not be extended:",
                "steps": [
                  {
                    "npc": "Sorry, I can't extend your PK skull beyond its existing duration."
                  }
                ],
                "id": "MwKUKd"
              }
            ],
            "id": "cdFsBA"
          },
          {
            "text": "What do the different colour skulls mean?",
            "steps": [
              {
                "player": "What do the different colour skulls mean?"
              },
              {
                "npc": "The different colours represent risk values. Bronze is up to 200,000. Iron is up to 800,000. Green is up to 2,000,000. Blue is up to 8,000,000. Red is any amount greater than 8,000,000."
              },
              {
                "type": "jump",
                "reference": "other",
                "id": "3i3gRv"
              }
            ]
          }
        ]
      }
