    "standard-dialogue-after-the-fremennik-trials-without-a-skeletal-piece": [
      {
        "player": "Hello Peer."
      },
      {
        "npc": "Greetings to you [brother/sister] [Fremennik name]! What brings you to see me again?"
      },
      {
        "type": "choice",
        "options": [
          {
            "text": "Can you tell my future?",
            "steps": [
              {
                "player": "I was wondering if you could give me a reading on my future...?"
              },
              {
                "npc": "Ah, you would like a prediction? I do not see that that would be so difficult... wait a moment..."
              },
              {
                "type": "action",
                "text": "Dialogue box disappears for a few seconds",
                "id": "PtsAHR"
              },
              {
                "type": "random",
                "options": [
                  {
                    "text": "Dialogue 1",
                    "steps": [
                      {
                        "npc": "Here is your prediction: The enemy called [fire giant/ghost/goblin/green dragon/hobgoblin/lesser demon/moss giant/ogre/skeleton/zombie] is your lucky totem this day."
                      }
                    ]
                  },
                  {
                    "text": "Dialogue 2",
                    "steps": [
                      {
                        "npc": "Here is your prediction: The stars tell me that you should use a [battleaxe/crossbow/dagger/javelin/long sword/mace/scimitar/short sword/spear/warhammer] in combat today."
                      }
                    ]
                  },
                  {
                    "text": "Dialogue 3",
                    "steps": [
                      {
                        "npc": "Here is your prediction: The place called [Al Kharid/Ardougne/Burthorpe/Canifis/Falador/Karamja/Varrock/The Wilderness/Yanille] will be worth your time to visit."
                      }
                    ]
                  },
                  {
                    "text": "Dialogue 4",
                    "steps": [
                      {
                        "npc": "Here is your prediction: You would be wise to train the skill [Agility/Cooking/Crafting/Fishing/Fletching/Herblore/Mining/Runecrafting/Smithing/Thieving] today."
                      }
                    ]
                  },
                  {
                    "text": "Dialogue 5",
                    "steps": [
                      {
                        "npc": "Here is your prediction: The colour [black/blue/brown/cyan/green/pink/purple/red/white/yellow] will bring you luck this day."
                      }
                    ]
                  },
                  {
                    "text": "Dialogue 6",
                    "steps": [
                      {
                        "npc": "Here is your prediction: You will find luck today with the number [one/two/three/four/five/six/seven/eight/nine/ten]."
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "text": "Can you bank my stuff?",
