      "text": "If the player is not wearing Vyre noble clothing:",
      "steps": [
        {
          "npc": "Human! Get back to the slave pens before I call the guards!"
        },
        {
          "type": "end"
        }
      ],
      "id": "Atg2EU"
    },
    {
      "npc": "What do you want?"
    },
    {
      "type": "choice",
      "options": [
        {
          "text": "I want to access my bank account",
          "steps": [
            {
              "type": "action",
              "action": "open_interface",
              "target": "Bank",
              "id": "v-Z093"
            }
          ]
        },
        {
          "text": "I want to check my PIN settings.",
          "steps": [
            {
              "type": "action",
              "action": "open_interface",
              "target": "Bank PIN",
              "id": "N_m0BS"
            }
          ]
        },
        {
          "text": "I want to collect items.",
          "steps": [
            {
              "type": "action",
              "action": "open_interface",
              "target": "Grand Exchange collection box",
              "id": "-_Rlt0"
