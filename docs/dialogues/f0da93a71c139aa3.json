          ]
        },
        {
          "text": "I want to buy more bank slots.",
          "steps": [
            {
              "player": "I want to buy more bank slots."
            },
            {
              "type": "condition",
              "text": "If the player is an Ultimate Ironman:",
              "steps": [
                {
                  "npc": "Why? You don't use the bank."
