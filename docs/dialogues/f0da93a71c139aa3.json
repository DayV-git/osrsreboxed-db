                {
                  "player": "Oh yeah... Never mind then."
                },
                {
                  "type": "end"
                }
              ],
              "id": "1B3RVM"
            },
            {
              "npc": "I can sell you up to [number] additional bank slots in sets of 50. How many are you interested in buying?"
            },
            {
              "type": "action",
              "text": "(Bank space purchase interface opens.)",
              "action": "open_interface",
              "action_source": "text",
              "target": "Bank space purchase",
              "id": "eoEZhJ"
            },
            {
              "type": "choice",
              "prompt": "How many do you wish to purchase?",
              "options": [
                {
                  "text": "[number] slots ([number] coins):",
                  "steps": [
                    {
                      "player": "[number] slots please."
                    },
                    {
                      "npc": "Buying [number] additional bank slots will cost [number] coins. Be warned, this purchase is not reversible. Are you happy to proceed?"
                    },
                    {
                      "type": "choice",
                      "options": [
                        {
                          "text": "Yes.",
                          "steps": [
                            {
                              "type": "condition",
                              "text": "If the player does not have enough coins in their inventory or bank:",
                              "steps": [
                                {
                                  "player": "Oh... I don't seem to have enough money for that. Never mind."
                                },
                                {
                                  "type": "end"
                                }
                              ],
                              "id": "ZpFoKM"
                            },
                            {
                              "player": "Yes, I'm happy with that."
                            },
                            {
                              "npc": "Your additional bank slots have been added."
                            }
                          ]
                        },
                        {
                          "text": "No.",
                          "steps": [
                            {
                              "player": "Actually, I've changed my mind."
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "Do I have any other options for extra bank space?",
                  "steps": [
                    {
                      "type": "condition",
                      "text": "If the player has set up a bank PIN, an Authenticator and is playing on a Jagex Account:",
                      "steps": [
                        {
                          "npc": "I'm afraid not! You've already got as much bank space as you can obtain without purchase."
                        },
                        {
                          "npc": "I can sell you up to [number] additional bank slots in sets of 50. How many are you interested in buying?"
                        },
                        {
                          "type": "jump",
                          "reference": "above",
                          "id": "rs09vg"
                        }
                      ],
                      "id": "VZkwFr"
                    },
                    {
                      "type": "condition",
                      "text": "If the player does not satisfy all three conditions:",
                      "steps": [
                        {
                          "npc": "I'm not supposed to tell you this, but you can obtain more bank space by [setting up a PIN], [setting up an Authenticator] [or] [upgrading to a Jagex Account]."
                        },
                        {
                          "npc": "I can sell you up to [number] additional bank slots in sets of 50. How many are you interested in buying?"
                        },
                        {
                          "type": "jump",
                          "reference": "above",
                          "id": "MypZn0"
                        }
                      ],
                      "id": "EvyHPC"
                    }
                  ]
                },
                {
                  "text": "(Cancel)",
                  "steps": [
                    {
                      "player": "Actually, I've changed my mind."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "What is this place?",
          "steps": [
            {
              "player": "What is this place?"
            },
            {
              "npc": "You blind? It's a bank. You can store your valuables here... if you have any."
            }
          ]
        }
      ]
    }
  ]
