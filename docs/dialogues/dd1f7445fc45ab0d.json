{
  "default": null,
  "variants": {
    "standard-dialogue": [
      {
        "type": "action",
        "text": "The Butler bows",
        "action": "emote",
        "action_source": "text",
        "id": "0gXfwH"
      },
      {
        "npc": "Good day, [sir/madam]. Would [sir/madam] care to hire a good butler for 5000 coins?"
      },
      {
        "type": "choice",
        "options": [
          {
            "text": "What can you do?",
            "steps": [
              {
                "player": "What can you do?"
              },
              {
                "npc": "I can fulfill all [sir/madam]'s domestic service needs with efficiency and impeccable manners. I hate to boast, but I can say with confidence that no mortal can make trips to the bank or sawmill faster than I!"
              }
            ]
          },
          {
            "text": "Tell me about your previous jobs",
            "steps": [
              {
                "player": "Tell me about your previous jobs."
              },
              {
                "npc": "From a humble beginning as a dish-washer I have worked my way up through the ranks of domestic service in the households of nobles from Varrock and Ardougne. As a life-long servant I have naturally"
              },
              {
                "npc": "suppressed any personality of my own and trained myself never to use the second person when talking to a superior. I have usually worked in the large households of the aristocracy, but now that such a large"
              },
              {
                "npc": "number of private persons are building their own houses I decided to offer them my services."
              }
            ]
          },
          {
            "text": "You're hired!",
            "steps": [
              {
                "type": "condition",
                "text": "If the player does not have at least 40 Construction:",
                "steps": [
                  {
                    "npc": "I must respectfully decline, [sir/madam]. I offer a very exclusive service and will only work for people with over level 40 Construction."
                  },
                  {
                    "type": "end"
                  }
                ],
                "id": "w-hvOv"
              },
              {
                "type": "condition",
                "text": "If the player has a servant already:",
                "steps": [
                  {
                    "type": "message",
                    "text": "You already have a servant.",
                    "id": "YfgxkE"
                  },
                  {
                    "type": "end"
                  }
                ],
                "id": "GUMdVw"
              },
              {
                "type": "condition",
                "text": "If the player does not have a second bedroom with a bed:",
                "steps": [
                  {
                    "type": "message",
                    "text": "You need a second bedroom with a bed for your servant to sleep in.",
                    "id": "DF1l2m"
                  },
                  {
                    "type": "end"
                  }
                ],
                "id": "g4ICgQ"
              },
              {
                "type": "condition",
                "text": "If the player does not have enough money in their inventory:",
                "steps": [
                  {
                    "player": "You're hired... well, I don't have the money on me, but can I owe you? I'm good for it, honest."
                  },
                  {
                    "npc": "I regret that I cannot agree to begin my duties until I have been paid."
                  },
                  {
                    "type": "end"
                  }
                ],
                "id": "pzjymx"
              },
              {
                "type": "condition",
                "text": "If the player has the above conditions met and the player doesn't have a servant:",
                "steps": [
                  {
                    "npc": "Thank you, [sir/madam]. I can start work immediately."
                  }
                ],
                "id": "TLyXT2"
              }
            ]
          }
        ]
      }
    ],
