            ]
          },
          {
            "text": "Dialogue 15",
            "steps": [
              {
                "npc": "Please tell me that was the last verse..."
              }
            ]
          },
          {
            "text": "Dialogue 16",
            "steps": [
              {
                "npc": "Please... Kill me now..."
