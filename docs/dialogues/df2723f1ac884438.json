            ]
          },
          {
            "text": "Dialogue 18",
            "steps": [
              {
                "npc": "Never before have mine ears been so offended!"
              }
            ]
          },
          {
            "text": "Dialogue 19",
            "steps": [
              {
                "npc": "Worst. Bard. EVER."
