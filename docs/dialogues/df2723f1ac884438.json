            ]
          },
          {
            "text": "Dialogue 21",
            "steps": [
              {
                "npc": "If you stopped singing"
              }
            ]
          },
          {
            "text": "Dialogue 22",
            "steps": [
              {
                "npc": "The screams of my dying comrades sound better!"
              }
            ]
          },
          {
            "text": "Dialogue 23",
            "steps": [
              {
                "npc": "My grandmother could do better, and she is dead!"
              }
            ]
          },
          {
            "text": "Dialogue 24",
            "steps": [
              {
                "npc": "I do such feats before breakfast!"
              }
            ]
          },
          {
