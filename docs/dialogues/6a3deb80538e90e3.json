{
  "steps": [
    {
      "npc": "Welcome to the Burthorpe Games Rooms!"
    },
    {
      "type": "choice",
      "options": [
        {
          "text": "How do I play board games?",
          "steps": [
            {
              "player": "How do I play board games?"
            },
            {
              "npc": "You can challenge someone to a game anywhere in the Games Zone (except on a PvP or Deadman world) by using the right click option."
            },
            {
              "npc": "Choose the type of game and then choose the options you want such as time per move."
            },
            {
              "npc": "If your opponent accepts the challenge you will be taken to one of the tables around where you will play your game of choice."
            },
            {
              "npc": "Once you have finished your game you will come back here where you can challenge again! We also have tables in a few pubs around the world!"
            },
            {
              "type": "jump",
              "reference": "initial",
              "id": "j9F_eL"
            }
          ]
        },
        {
          "text": "What games can I play?",
          "steps": [
            {
              "player": "What games can I play?"
            },
            {
              "npc": "Currently we offer Draughts, Runelink, Runesquares, and Runeversi."
            },
            {
              "type": "choice",
              "options": [
                {
                  "text": "Draughts?",
                  "steps": [
                    {
                      "player": "Draughts?"
                    },
                    {
                      "npc": "Draughts uses standard rules, apart from: a draw is declared if no piece has been taken or promoted for forty moves."
                    },
                    {
                      "type": "jump",
                      "reference": "initial",
                      "id": "-sdD7J"
                    }
                  ]
                },
                {
                  "text": "Runelink?",
                  "steps": [
                    {
                      "player": "Runelink?"
                    },
                    {
                      "npc": "Yup, you have to get four runes in row."
                    },
                    {
                      "type": "jump",
                      "reference": "initial",
                      "id": "pq_KnT"
                    }
                  ]
                },
                {
                  "text": "Runesquares?",
                  "steps": [
                    {
                      "player": "Runesquares?"
                    },
                    {
                      "npc": "Yes, you take it in turns to add a line with the goal of making squares. Everytime you make a square you take another turn."
                    },
                    {
                      "type": "jump",
                      "reference": "initial",
                      "id": "rVVORe"
                    }
                  ]
                },
                {
                  "text": "Runeversi?",
                  "steps": [
                    {
                      "player": "Runeversi?"
                    },
                    {
                      "npc": "Yep, the aim is to have more of your runes on the board than your opponent. You can take your opponents pieces by trapping them between your own."
                    },
                    {
                      "type": "jump",
                      "reference": "initial",
                      "id": "0W01JM"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Can I buy a drink please?",
          "steps": [
            {
              "player": "Can I buy a drink please?"
            },
            {
              "npc": "I'm afraid I don't sell drinks."
            }
          ]
        },
        {
          "text": "Thanks!",
          "steps": [
            {
              "player": "Thanks!"
            }
          ]
        }
      ]
    }
  ]
