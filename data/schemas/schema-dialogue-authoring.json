{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": [
      "source",
      "sections"
    ],
    "properties": {
      "source": {
        "type": "object",
        "required": [
          "page",
          "revision"
        ],
        "properties": {
          "page": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      },
      "sections": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "participants": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "npc_ids": {
        "type": "array",
        "items": {
          "type": "integer"
        }
      }
    },
    "additionalProperties": false
  }
}
